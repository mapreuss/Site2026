---
layout: base.njk
---

{% set isPost = page.url != '/blog/' and page.url != '/blog' %}

<section id="portfolio-page">
    <article class="page-title-section">
        <p class="chapeu"><small id="blog-chapeu">Blog</small></p>
        {% if isPost %}
        <h2 id="blog-title">{{ title | safe }}</h2>
        <p id="blog-description">{{ author }} em {{ (date or page.date) | formatarDataBR }}</p>
        {% else %}
        <h2 id="blog-title">Blog</h2>
        <p id="blog-description">Dia a dia, hobbies, reflexões e nada com nada.</p>
        {% endif %}
    </article>

    <section class="col-2">
        <article{% if isPost %} class="internal"{% endif %}>
            {{ content | safe }}

            {% if isPost %}
            {% set postCategories = categories | normalizarCategorias %}
            {% set postTags = tags | normalizarTags %}
            {% if (postCategories and postCategories.length > 0) or (postTags and postTags.length > 0) %}
            <ul class="tags post-meta-tags" style="margin-top: 2rem;">
                {% for category in postCategories %}
                <li><a href="/blog/?categoria={{ category | urlencode }}" class="cat-link" data-category="{{ category }}">{{ category }}</a></li>
                {% endfor %}
                {% for tag in postTags %}
                <li><a href="/blog/?tag={{ tag | urlencode }}" class="tag-link" data-tag="{{ tag }}">{{ tag }}</a></li>
                {% endfor %}
            </ul>
            {% endif %}
            {% endif %}
        </article>

        <aside>
            <article class="widget">
                <p class="chapeu"><small>Últimos posts</small></p>
                <ul>
                    {% for item in collections.blog | reverse | limit(5) %}
                    <li>
                        <a href="{{ item.url }}">{{ item.data.title }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </article>
            <article class="widget">
                <p class="chapeu"><small>Categorias</small></p>
                <ul class="widget-categorias">
                    {% set categorias = collections.blog | categoriasComContagem %}
                    
                    {% for category in categorias %}
                        <li>
                            <a href="/blog/?categoria={{ category.nome | urlencode }}" class="cat-link" data-category="{{ category.nome }}">{{ category.nome }}</a> <span class="tag-count">{{ category.quantidade }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </article>        
            <article class="widget">
                <p class="chapeu"><small>Tags</small></p>
                <ul class="tags widget-tags">
                    {% set listaTags = collections.blog | tagsComContagem %}
                    
                    {% for tag in listaTags %}
                        <li>
                            <a href="/blog/?tag={{ tag.nome | urlencode }}" class="tag-link" data-tag="{{ tag.nome }}">{{ tag.nome }}</a> <span class="tag-count">{{ tag.quantidade }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </article>
            <article class="widget">
                <p class="chapeu"><small>Arquivo</small></p>
                <ul class="widget-categorias widget-arquivo">
                    {% set listaArquivo = collections.blog | arquivoPorAnoMes %}
                    {% for grupo in listaArquivo %}
                        <li>
                            <a href="/blog/?arquivo={{ grupo.chave }}" class="arquivo-link" data-archive="{{ grupo.chave }}">{{ grupo.mes }} {{ grupo.ano }}</a>
                            <span class="tag-count">{{ grupo.quantidade }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </article>         
            <article class="widget widget-rss">
                <p class="chapeu"><small>Feed RSS</small></p>
                <p class="widget-rss-desc">Acompanhe o blog pelo seu leitor de RSS favorito e não perca nenhum post.</p>
                <a href="/feed.xml" target="_blank" class="btn-rss" title="Assinar feed RSS do blog">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 11a9 9 0 0 1 9 9"/>
                        <path d="M4 4a16 16 0 0 1 16 16"/>
                        <circle cx="5" cy="19" r="1"/>
                    </svg>
                    Assinar RSS
                </a>
            </article>       
        </aside>
    </section>

</section>
<script src="/js/blog-filter.js" defer></script>