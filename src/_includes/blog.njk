---
layout: base.njk
---

<section id="portfolio-page">
    <article>
        <p class="chapeu"><small>Blog</small></p>
        <h2>Blog</h2>
        <p>Dia a dia, hobbies, reflexões e nada com nada.</p>
    </article>

    <section class="col-2">
        <article class="internal">
            {{ content | safe }}
        </article>

        <aside>
            <article class="widget">
                <p class="chapeu"><small>Últimos posts</small></p>
                <ul>
                    {% for item in collections.blog | sortBy("fileSlug") | reverse %}
                    <li>
                        <a href="{{ item.url }}">{{ item.data.title }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </article>
            <article class="widget">
                <p class="chapeu"><small>Categorias</small></p>
                <ul>
                    {% for item in collections.blog | sortBy("fileSlug") | reverse %}
                    <li>
                        <a href="{{ item.url }}">{{ item.data.title }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </article>        
            <article class="widget">
                <p class="chapeu"><small>Tags</small></p>
                <ul>
                    {% for item in collections.blog | sortBy("fileSlug") | reverse %}
                    <li>
                        <a href="{{ item.url }}">{{ item.data.title }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </article>                
        </aside>
    </section>

</section>